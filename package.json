{
  "name": "ieee-techbridge-website",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "test": "node --test tests/*.test.mjs",
    "build:cloudflare": "next build",
    "preview": "wrangler dev",
    "deploy": "next build && wrangler deploy",
    "start": "wrangler dev",
    "lint": "next lint",
    "generate:map": "node scripts/generate-world-path.mjs"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.18.2"
}
