# Copy to .env.local for local dev; set the same key in your host's
# build environment variables in Cloudflare Pages for production.

# From Apps Script: Deploy > New deployment > Web app > Web app URL.
# See README.md, "Connecting the forms".
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

# Canonical origin used in metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://ieeetechbridge.com
